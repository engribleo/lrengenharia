<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LR Engenharia | Leonardo Ribeiro</title>
  <meta name="description" content="Projetos, execução e gerenciamento de obras em Carazinho e região.">
  <style>
    :root{
      --verde:#0B6E3B;
      --verde-escuro:#064b2a;
      --laranja:#F37021;
      --grafite:#252525;
      --cinza:#f3f5f4;
      --branco:#ffffff;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:Arial, Helvetica, sans-serif;
      color:var(--grafite);
      background:linear-gradient(180deg,#fff 0%,#f6f8f7 100%);
    }
    .wrap{max-width:980px;margin:auto;padding:24px}
    .hero{
      background:#fff;
      border-radius:24px;
      box-shadow:0 18px 50px rgba(0,0,0,.10);
      overflow:hidden;
      border:1px solid #e8ecea;
    }
    .top{
      display:grid;
      grid-template-columns:1.05fr .95fr;
      min-height:470px;
    }
    .brand{padding:46px 44px}
    .brand img{width:min(100%,460px);display:block;margin:0 auto 24px}
    .eyebrow{color:var(--laranja);font-weight:800;letter-spacing:.13em;text-transform:uppercase;font-size:13px}
    h1{font-size:42px;line-height:1.08;margin:10px 0 16px;color:var(--verde-escuro)}
    .lead{font-size:18px;line-height:1.65;color:#4a4a4a}
    .actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
    .btn{
      display:inline-flex;align-items:center;justify-content:center;
      padding:14px 18px;border-radius:12px;text-decoration:none;
      font-weight:800;border:2px solid transparent;
    }
    .btn.primary{background:var(--verde);color:#fff}
    .btn.secondary{background:#fff;color:var(--verde);border-color:var(--verde)}
    .panel{
      background:linear-gradient(145deg,var(--verde-escuro),var(--verde));
      color:#fff;padding:44px 38px;display:flex;flex-direction:column;justify-content:center
    }
    .panel h2{font-size:28px;margin:0 0 20px}
    .contact{display:grid;gap:14px}
    .contact a,.contact div{color:#fff;text-decoration:none;font-size:17px}
    .services{
      display:grid;grid-template-columns:repeat(3,1fr);gap:16px;
      padding:28px;background:#fff;border-top:1px solid #edf0ee
    }
    .card{background:var(--cinza);border-radius:16px;padding:22px;border-left:5px solid var(--laranja)}
    .card h3{margin:0 0 7px;color:var(--verde-escuro)}
    .qr{
      display:grid;grid-template-columns:160px 1fr;align-items:center;gap:24px;
      margin-top:22px;padding:20px;border-radius:16px;background:rgba(255,255,255,.10)
    }
    .qr img{width:160px;border-radius:12px;background:#fff;padding:8px}
    footer{text-align:center;padding:28px 12px;color:#666;font-size:14px}
    @media(max-width:760px){
      .top{grid-template-columns:1fr}
      .brand,.panel{padding:30px 24px}
      h1{font-size:34px}
      .services{grid-template-columns:1fr}
      .qr{grid-template-columns:1fr;text-align:center}
      .qr img{margin:auto}
    }
  </style>
</head>
<body>
  <main class="wrap">
    <section class="hero">
      <div class="top">
        <div class="brand">
          <img src="logo-lr.png" alt="LR Engenharia">
          <div class="eyebrow">Engenharia Civil</div>
          <h1>Projetando qualidade, construindo confiança.</h1>
          <p class="lead">
            Soluções em projetos, execução e gerenciamento de obras,
            com responsabilidade técnica, organização e compromisso em cada etapa.
          </p>
          <div class="actions">
            <a class="btn primary" href="https://wa.me/5554999953141?text=Ol%C3%A1%20Leonardo%2C%20gostaria%20de%20solicitar%20um%20or%C3%A7amento." target="_blank" rel="noopener">Falar no WhatsApp</a>
            <a class="btn secondary" href="https://instagram.com/eng.leo.rib" target="_blank" rel="noopener">Ver Instagram</a>
          </div>
        </div>
        <aside class="panel">
          <h2>Leonardo Ribeiro</h2>
          <div class="contact">
            <div>Engenheiro Civil • CREA-RS 249056</div>
            <a href="tel:+5554999953141">(54) 99995-3141</a>
            <a href="mailto:leo.rib1991@gmail.com">leo.rib1991@gmail.com</a>
            <a href="https://instagram.com/eng.leo.rib" target="_blank" rel="noopener">@eng.leo.rib</a>
            <div>Carazinho – RS</div>
          </div>
          <div class="qr">
            <img src="qr-whatsapp.png" alt="QR Code para WhatsApp">
            <div>
              <strong>Escaneie para solicitar um orçamento</strong>
              <p>Este QR Code abre diretamente uma conversa no WhatsApp.</p>
            </div>
          </div>
        </aside>
      </div>
      <div class="services">
        <div class="card"><h3>Projetos</h3><div>Projetos residenciais, comerciais e soluções técnicas.</div></div>
        <div class="card"><h3>Execução</h3><div>Acompanhamento e execução de obras com foco em qualidade.</div></div>
        <div class="card"><h3>Gerenciamento</h3><div>Planejamento, fiscalização e controle das etapas da obra.</div></div>
      </div>
    </section>
    <footer>LR Engenharia • Carazinho – RS</footer>
  </main>
</body>
</html>
